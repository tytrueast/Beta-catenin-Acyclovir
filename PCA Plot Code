library(readr)
library(dplyr)
library(ggplot2)
library(ggrepel)

# Load expression matrix
mat <- read_tsv("~/Downloads/N545FJ-expression-matrix.tsv", show_col_types = FALSE)

# Define metadata
sample_meta <- data.frame(
  sample_id  = paste0("N545FJ_", 1:6),
  label      = c("KI_0Acy", "KI_62.5Acy", "KI_250Acy",
                 "KI_500Acy", "NTD", "NTD_Acy"),
  condition  = c("Degrader", "Degrader", "Degrader",
                 "Degrader", "Control", "Control"),
  acyclovir  = c("0", "62.5", "250", "500", "0", "500")
)

# Extract CPM columns and build matrix with gene names as rownames
cpm_cols <- paste0("N545FJ_", 1:6, "_cpm")
cpm_df <- mat %>% filter(gene_biotype == "protein_coding") %>%
  select(gene_id, gene_name, all_of(cpm_cols))
cpm_mat <- as.matrix(cpm_df[, cpm_cols])
rownames(cpm_mat) <- make.unique(as.character(cpm_df$gene_name))
colnames(cpm_mat) <- sample_meta$label

# Filter
expressed <- rowSums(cpm_mat > 1) >= 2
log_mat <- log2(cpm_mat[expressed, ] + 1)

# Run PCA on transposed matrix (samples as rows, genes as columns)
pca_res <- prcomp(t(log_mat), scale. = TRUE)
pca_df  <- as.data.frame(pca_res$x[, 1:3])
pca_df$label     <- rownames(pca_df)
pca_df$condition <- sample_meta$condition
pca_df$acyclovir <- sample_meta$acyclovir

# Calculate % variance explained by each PC
var_exp <- round(summary(pca_res)$importance[2, 1:3] * 100, 1)

# Plot
p_pca <- ggplot(pca_df, aes(x = PC1, y = PC2,
                              color = condition,
                              shape = acyclovir,
                              label = label)) +
  geom_point(size = 5, alpha = 0.9) +
  geom_text_repel(size = 3.5, fontface = "bold",
                  box.padding = 0.5, show.legend = FALSE) +
  scale_color_manual(values = c("Degrader" = "#E63946",
                                 "Control"  = "#457B9D")) +
  scale_shape_manual(values = c("0" = 16, "62.5" = 17,
                                 "250" = 15, "500" = 18)) +
  labs(title = "PCA of DPPM003 Samples",
       subtitle = "Protein-coding genes, log2(CPM+1), scaled",
       x = paste0("PC1 (", var_exp[1], "% variance)"),
       y = paste0("PC2 (", var_exp[2], "% variance)"),
       color = "Condition", shape = "Acyclovir (uM)") +
  theme_bw(base_size = 13) +
  theme(plot.title = element_text(face = "bold"),
        legend.position = "right")

ggsave("~/Downloads/plot5_pca.png", p_pca, width = 8, height = 6, dpi = 150)
