library(dplyr)
library(ggplot2)
library(forcats)

p_pathway <- pathways %>%
  filter(!is.na(NES)) %>%
  mutate(
    Direction = if_else(NES > 0, "Enriched (Up)", "Suppressed (Down)"),
    sig_label = case_when(
      FDR_Q_VAL < 0.05 ~ "FDR < 0.05",
      FDR_Q_VAL < 0.25 ~ "FDR < 0.25",
      TRUE             ~ "FDR >= 0.25"
    ),
    TERM = fct_reorder(TERM, NES),
    label_x = NES + if_else(NES > 0, 0.02, -0.02),
    hjust = if_else(NES > 0, 0, 1)
  ) %>%
  ggplot(aes(NES, TERM, fill = Direction, alpha = sig_label)) +
  geom_col() +
  geom_vline(xintercept = 0, linewidth = 0.5) +
  geom_text(aes(label = round(NES, 2), x = label_x, hjust = hjust),
            size = 3.2) +
  scale_fill_manual(values = c(
    "Enriched (Up)" = "#E63946",
    "Suppressed (Down)" = "#457B9D"
  )) +
  scale_alpha_manual(values = c(
    "FDR < 0.05" = 1,
    "FDR < 0.25" = 0.75,
    "FDR >= 0.25" = 0.45
  )) +
  labs(
    title = "GSEA Pathway Enrichment — DPPM003",
    subtitle = "NES = Normalized Enrichment Score; positive = upregulated in treatment",
    x = "Normalized Enrichment Score (NES)",
    y = NULL,
    fill = "Direction",
    alpha = "Significance"
  ) +
  theme_bw(base_size = 12) +
  theme(
    plot.title = element_text(face = "bold"),
    axis.text.y = element_text(size = 10),
    legend.position = "bottom"
  )

ggsave("~/Downloads/plot4_pathways.pdf", p_pathway, width = 11, height = 7)
